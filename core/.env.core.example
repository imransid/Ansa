# core's settings. Copy to ../.env.core (git ignores .env*), fill in, run `make run`.
CORE_LISTEN_ADDR=127.0.0.1:8080
# The database core uses. Locally: the same address as DATABASE_URL in
# .env.local (the Docker database, port 5450).
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DATABASE
# The key stored secret text is encrypted with (32 bytes, base64; make one
# once: openssl rand -base64 32). Back it up: losing it loses every encrypted
# text. For a database the old backend wrote: its DATA_ENCRYPTION_KEY.
DATA_ENCRYPTION_KEY=
BRAIN_URL=http://127.0.0.1:8090
# openssl rand -hex 32 — the same value in the brain's settings.
BRAIN_SHARED_SECRET=
# "development" on your laptop (allows the stand-ins). A server sets
# "production"; a missing ANSA_ENV counts as production.
ANSA_ENV=development
# Signs the login cookie (Better Auth's format) and makes the rate limit keys
# (openssl rand -hex 32). Changing it logs everyone out. For a database the
# old backend wrote: its BETTER_AUTH_SECRET.
BETTER_AUTH_SECRET=
# A local database OF ITS OWN for core's tests (they write and delete their
# own rows): never the one a running core uses, whose periodic work would
# reach the tests' companies. Make it once: CREATE DATABASE ansa_test; then
# from the repository root: DATABASE_URL=<this address> pnpm db:migrate
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/ansa_test
# Telegram (all three or none): ansa's bot from @BotFather, and the webhook secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# The screens' public address, for links in emails (the same value as
# APP_URL in .env.local).
APP_URL=http://localhost:3000
# Email: "true" sends through Resend (then EMAIL_FROM and RESEND_API_KEY are
# required); anything else writes files to .dev-emails/. Production: "true".
SEND_REAL_EMAIL=
EMAIL_FROM=
RESEND_API_KEY=
# Resend's webhook signing secret (whsec_...): received emails and delivery problems.
RESEND_WEBHOOK_SECRET=
# The domain of every company's forwarding address (never change it once used). Development: inbound.ansa.test.
INBOUND_EMAIL_DOMAIN=
# Where development stand-ins write .dev-emails/ and .dev-messages/ (default: the repository root).
ANSA_DEV_FOLDER=..
# ansa's Meta app (both or none): Facebook Pages and Messenger; the secret signs Messenger's webhook.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Meta's one-time webhook setup check (openssl rand -hex 32).
MESSENGER_VERIFY_TOKEN=
# WhatsApp Business (step 56, the same Meta app): the WhatsApp webhook's
# setup check (openssl rand -hex 32), and the id of the Facebook Login for
# Business configuration made for WhatsApp Embedded Signup (docs/going-live.md).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_SIGNUP_CONFIG_ID=
# Signs the screens' requests to core's API (openssl rand -hex 32; the same value in .env.local).
SCREENS_SHARED_SECRET=

# Private files (documents, media, recordings). Development: the folder
# <ANSA_DEV_FOLDER>/.dev-files. Production requires Cloudflare R2: a PRIVATE
# bucket and an API token for it.
USE_R2_STORAGE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Payments: real only when USE_STRIPE is exactly "true" (then all five below
# are required: each package's Stripe price, step 57). Development without
# it: the Billing page's simulate buttons.
USE_STRIPE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PERSONAL=
STRIPE_PRICE_ID_BUSINESS=
STRIPE_PRICE_ID_PRO=

# "off": serve requests and run jobs, but none of the periodic work (a second
# core beside a running one, or a preview of the screens).
CORE_SCHEDULER=

# Phone calls (Vapi). Without VAPI_WEBHOOK_SECRET the webhook refuses
# everything. How Vapi signs is a setting, so its real format can be matched
# without code changes (defaults: a Vapi HMAC credential's own).
VAPI_WEBHOOK_SECRET=
VAPI_SIGNATURE_HEADER=x-signature
VAPI_TIMESTAMP_HEADER=x-timestamp
VAPI_SIGNATURE_ALGORITHM=sha256
VAPI_SIGNATURE_PAYLOAD={timestamp}.{body}
VAPI_SIGNATURE_ENCODING=hex
VAPI_SIGNATURE_PREFIX=
VAPI_TIMESTAMP_UNIT=seconds
VAPI_TIMESTAMP_TOLERANCE_SECONDS=300
# Recordings are copied only from these hosts (comma-separated).
VAPI_RECORDING_HOSTS=storage.vapi.ai

# Social accounts (both settings of a pair, or neither): ansa's developer app on
# LinkedIn, X and YouTube (a Google Cloud OAuth client). Without one,
# development offers a stand-in account and production says it isn't set up.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The image service for the media library: empty (development: the stand-in;
# production: image generation is off) or "dev-stand-in" (refused in production).
MEDIA_PROVIDER=

# The ansa phone app (paired by a QR code). DEVICE_API_URL is how a phone
# reaches core; it goes inside the QR code. Empty in development =
# http://127.0.0.1:8080 (the iPhone simulator; the Android emulator needs
# http://10.0.2.2:8080). A real phone on your Wi-Fi: set DEVICE_LISTEN_ADDR
# (e.g. 0.0.0.0:8081: core then also listens there, for the app's routes
# only) and DEVICE_API_URL=http://<this laptop's Wi-Fi address>:8081.
# Production: core's https address, and no DEVICE_LISTEN_ADDR (refused).
DEVICE_API_URL=
DEVICE_LISTEN_ADDR=

# The brain's own development settings (it reads this file too, see
# docs/backend/try-it.md). The practice phone (step 55) hears your voice with
# whisper.cpp on this computer: `brew install whisper-cpp`, then a model from
# https://huggingface.co/ggerganov/whisper.cpp (ggml-small.bin, multilingual).
# Production never uses them: a real phone line hears its callers itself.
WHISPER_MODEL_PATH=
# Only when whisper-cli isn't on the PATH.
WHISPER_CLI_PATH=
