# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real secrets.

# Local Postgres in Docker (docker-compose.yml reads these too)
POSTGRES_USER=ansa
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-24
POSTGRES_DB=ansa
DATABASE_URL=postgres://ansa:change-me-use-openssl-rand-hex-24@127.0.0.1:5450/ansa

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email. Real sending is OFF unless SEND_REAL_EMAIL=true. When off, every email
# is written to .dev-emails/ instead (git-ignored) and nothing is sent.
# When true, RESEND_API_KEY and EMAIL_FROM are required.
SEND_REAL_EMAIL=false
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=support@yourdomain.com
