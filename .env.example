# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real secrets.

# Local Postgres in Docker (docker-compose.yml reads these too)
POSTGRES_USER=ansa
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-24
POSTGRES_DB=ansa
DATABASE_URL=postgres://ansa:change-me-use-openssl-rand-hex-24@127.0.0.1:5450/ansa

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email. Real sending is OFF unless SEND_REAL_EMAIL=true. When off, every email
# is written to .dev-emails/ instead (git-ignored) and nothing is sent.
# When true, RESEND_API_KEY and EMAIL_FROM are required.
SEND_REAL_EMAIL=false
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=support@yourdomain.com

# Encrypts call transcripts at rest (AES-256-GCM). Generate: openssl rand -base64 32
# Back it up: losing this key means losing every stored transcript.
DATA_ENCRYPTION_KEY=

# Vapi webhooks. Generate the secret with: openssl rand -hex 32, and paste the
# same value into the Vapi HMAC credential.
VAPI_WEBHOOK_SECRET=
# Optional: how Vapi signs requests. Defaults shown; match the Vapi dashboard.
# VAPI_SIGNATURE_HEADER=x-vapi-signature
# VAPI_TIMESTAMP_HEADER=x-vapi-timestamp
# VAPI_SIGNATURE_ALGORITHM=sha256
# VAPI_SIGNATURE_PAYLOAD={timestamp}.{body}
# VAPI_SIGNATURE_ENCODING=hex
# VAPI_SIGNATURE_PREFIX=
# VAPI_TIMESTAMP_UNIT=seconds
# VAPI_TIMESTAMP_TOLERANCE_SECONDS=300
