# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real secrets.

# Local Postgres in Docker (docker-compose.yml reads these too)
POSTGRES_USER=ansa
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-24
POSTGRES_DB=ansa
DATABASE_URL=postgres://ansa:change-me-use-openssl-rand-hex-24@127.0.0.1:5450/ansa
# Production (Neon): the POOLED connection string (its host has -pooler), with
# sslmode=verify-full instead of require (docs/going-live.md, section 1).

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email. Real sending is OFF unless SEND_REAL_EMAIL=true. When off, every email
# is written to .dev-emails/ instead (git-ignored) and nothing is sent, and the
# content of received emails is read from .dev-inbound/ (written by
# pnpm simulate:inbound-email), never from Resend, even with RESEND_API_KEY set.
# When true, RESEND_API_KEY, EMAIL_FROM and INBOUND_EMAIL_DOMAIN (below) are required.
SEND_REAL_EMAIL=false
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=support@yourdomain.com

# Encrypts sensitive text at rest (AES-256-GCM): call transcripts and what the
# AI wrote about them, received emails' contents, ticket notes.
# Generate: openssl rand -base64 32
# Back it up: losing this key means losing all of that.
DATA_ENCRYPTION_KEY=

# Vapi webhooks. Generate the secret with: openssl rand -hex 32, and paste the
# same value into the Vapi HMAC credential.
VAPI_WEBHOOK_SECRET=
# Optional: how Vapi signs requests. Defaults shown (a Vapi HMAC credential's own
# defaults); match the Vapi dashboard.
# VAPI_SIGNATURE_HEADER=x-signature
# VAPI_TIMESTAMP_HEADER=x-timestamp
# VAPI_SIGNATURE_ALGORITHM=sha256
# VAPI_SIGNATURE_PAYLOAD={timestamp}.{body}
# VAPI_SIGNATURE_ENCODING=hex
# VAPI_SIGNATURE_PREFIX=
# VAPI_TIMESTAMP_UNIT=seconds
# VAPI_TIMESTAMP_TOLERANCE_SECONDS=300

# Claude: the call brain, email triage, and the Co-Founder's interview,
# plans, drafts, calendar plans and performance reviews. Without a key every
# call is escalated to a human, emails become tickets without the AI, and the
# Co-Founder says its AI isn't available (everything else still works).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Image and video generation for the Co-Founder's media library. No real
# image service is chosen yet, so the only value is the development stand-in
# (flat-colour PNGs made on this machine, no videos). Unset in development =
# the stand-in. Production refuses the stand-in: unset there, generation is
# off and the media page says it isn't set up (uploads still work).
# MEDIA_PROVIDER=dev-stand-in

# Social accounts for the Co-Founder (LinkedIn, Facebook Pages, X, YouTube):
# ansa's own developer app on each platform, every pair set together
# (docs/going-live.md, section 10). Without a pair, development offers a
# "stand-in account" instead (posts written to .dev-social/, git-ignored) and
# production says the platform isn't set up yet. Register this redirect URI
# with each platform: <BETTER_AUTH_URL>/api/social/<linkedin|facebook|x|youtube>/callback
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Private file storage (call recordings, uploaded docs). OFF unless "true":
# files then go to .dev-files/ (git-ignored). When "true", all four R2_ are required.
USE_R2_STORAGE=false
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Hosts call recordings may be downloaded from (comma separated).
# VAPI_RECORDING_HOSTS=storage.vapi.ai

# Resend webhooks (inbound email for step 15, bounces). Copy the signing secret
# Resend shows for the webhook (starts with whsec_). Without it they are refused.
# RESEND_WEBHOOK_SECRET=whsec_...
# The domain Resend receives email on: a subdomain of its own, never
# EMAIL_FROM's domain. Every company's forwarding address is
# c-<token>@<this domain>, shown on its Setup page. Never change it once
# companies forward to it: it is part of every forwarding address (and of the
# Reply-To of every email already sent), and only the current domain is read.
# Required when SEND_REAL_EMAIL=true. Unset (development): inbound.ansa.test,
# which can't receive real mail.
# INBOUND_EMAIL_DOMAIN=inbound.yourdomain.com

# The scheduled jobs: the daily cleanup (/api/cron/cleanup, which also sends
# due posts of the Co-Founder's publishing queue) and /api/cron/publish (call
# it as often as every minute to send scheduled posts on time). Generate:
# openssl rand -hex 32. On Vercel, setting it is enough for the daily job:
# Vercel Cron sends it automatically. Any other scheduler sends
# "Authorization: Bearer <CRON_SECRET>".
# CRON_SECRET=

# Payments (Stripe). OFF unless USE_STRIPE=true: the Billing page then only has
# "simulate" buttons and nothing is charged. When true, all three are required.
# The price (amount, currency, monthly/yearly) is set on the Stripe price itself.
USE_STRIPE=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
