# The screens' settings (Next.js). Copy this file to .env.local and fill in
# real values. .env.local is git-ignored. Never commit real secrets.
#
# ansa has three parts, each with its own settings:
# - the screens (this file);
# - core, the Go backend that does all the work and is the only part that
#   touches the database: core/.env.core.example;
# - the brain, the Python AI service: brain/README.md.

# The local Postgres in Docker (`pnpm db:up`; docker-compose.yml reads these),
# and its address for the migrations (`pnpm db:migrate`, drizzle-kit). The
# screens themselves never touch the database.
POSTGRES_USER=ansa
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-24
POSTGRES_DB=ansa
DATABASE_URL=postgres://ansa:change-me-use-openssl-rand-hex-24@127.0.0.1:5450/ansa
# Production (Neon): the POOLED connection string (its host has -pooler), with
# sslmode=verify-full instead of require (docs/going-live.md, section 1).

# Core's private address (the screens' every read and write goes there).
CORE_API_URL=http://127.0.0.1:8080
# Signs every request the screens send core: the SAME value as
# SCREENS_SHARED_SECRET in core's .env.core. Generate with: openssl rand -hex 32
SCREENS_SHARED_SECRET=
# The screens' own public address (robots.txt, the sitemap, https-only
# cookies). Production: https://app.yourdomain.com
APP_URL=http://localhost:3000
